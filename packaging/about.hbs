<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Digger: third-party licences</title>
<style>
:root { color-scheme: light dark; }
body { font-family: system-ui, sans-serif; line-height: 1.4; max-width: 50rem; margin: 0 auto; padding: 1rem; }
pre { white-space: pre-wrap; font-size: 0.85rem; max-height: 20rem; overflow-y: auto; border: 1px solid #8884; padding: 0.5rem; }
ul.crates { columns: 2; }
</style>
</head>
<body>
<main>
<h1>Third-party licences</h1>
<p>Digger is free software under the GNU General Public License, version 2
or later (see <code>LICENSE</code>; credits in <code>NOTICE</code>). The
program includes the Rust libraries listed below, each under the licence
shown with its text. Where a library offers a choice of licences, the first
licence of the list that applies is shown.</p>

<h2>Licences</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a>: {{count}} {{#if (eq count 1)}}library{{else}}libraries{{/if}}</li>
{{/each}}
</ul>

<h2>Licence texts</h2>
{{#each licenses}}
<section>
{{#if first_of_kind}}<h3 id="{{id}}">{{name}}</h3>{{/if}}
<p>Used by:</p>
<ul class="crates">
{{#each used_by}}
<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
</section>
{{/each}}
</main>
</body>
</html>
